<button id="clearvar_control">CLEARVAR</button>
<button id="not_found_control">404</button>

<script>
  import { initializeRecord } from "../scripts/achievementsRecord";

  document.querySelector("#clearvar_control")!.addEventListener("click", () => {
    initializeRecord(true);
    window.location.reload();
  });

  document
    .querySelector("#not_found_control")!
    .addEventListener("click", () => {
      window.location.assign("/not_found");
    });
</script>
