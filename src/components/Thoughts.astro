---
import Block from "../components/Block.astro";
---

<Block id="thoughts">
  <h1
    style={{
      marginBottom: 0,
    }}
  >
    My latest <strong>thoughts</strong>
  </h1>
  <small
    style={{
      display: "block",
      marginBottom: "45px",
    }}
  >
    (sort of like a rant journal? don't think too much about it)
  </small>
  <p>
    <strong>21.04.2026 01:00</strong> - New sitebox is up! Wasn't really sure what
    to do for it but I'm happy with the final result &lt;3
  </p>
  <p>
    <strong>05.04.2026 06:00</strong> - Achievements are up! Ping me on Discord if
    you get them all.
  </p>
  <p>
    <strong>03.04.2026 06:40</strong> - Responsive design up! Took a while to fine-tune
    it.
  </p>
  <p>
    <strong>03.04.2026</strong> - Got a 404 page up! I'm putting quite a bit of time
    into this thing. Next thing is the responsive design and the sitebox.
  </p>
  <p>
    <strong>01.04.2026</strong> - Finally got a preliminary version up. Responsiveness
    is still a WIP. Kinda regretting not doing mobile-first design.
  </p>

  <span id="scroll_down"><small>Scroll down ↓</small></span>
  <span id="sentinel"></span>
</Block>

<style lang="scss">
  #thoughts {
    max-height: 400px;
    overflow-y: scroll;
    position: relative;
    padding-bottom: 45px;

    @media (max-width: 700px) {
      padding-top: 80px;
    }

    @media (max-width: 1038px) {
      h1,
      small {
        text-align: center;
      }
    }

    #scroll_down {
      position: sticky;
      bottom: 0;
      right: 0;
      display: block;
      width: fit-content;
      margin-left: auto;
      opacity: 0.5;

      @media (max-width: 700px) {
        position: absolute;
        top: 50px;
        bottom: auto;
        right: 15px;
      }
    }

    p {
      margin-bottom: 16px;
      max-width: 70%;

      @media (max-width: 700px) {
        max-width: 100%;
      }
    }
  }
</style>

<script>
  import { getRecord, setRecord } from "../scripts/achievementsRecord";

  const thoughtsEl = document.querySelector("#thoughts")!;
  const sentinel = document.querySelector("#sentinel")!;

  if (getRecord("captains_journal") !== 100) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setRecord("captains_journal", 100);
          observer.disconnect();
        }
      },
      { root: thoughtsEl, threshold: 1.0 },
    );

    thoughtsEl.addEventListener(
      "scroll",
      () => {
        observer.observe(sentinel);
      },
      { once: true },
    );
  }
</script>
