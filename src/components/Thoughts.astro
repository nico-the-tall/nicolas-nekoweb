---
import Block from "../components/Block.astro";
import rawThoughts from "../constants/thoughts";

const thoughts = rawThoughts.toSorted((a, b) => b.timestamp - a.timestamp);
---

<Block id="thoughts">
  <h1
    style={{
      marginBottom: 0,
    }}
  >
    My latest <strong>thoughts</strong>
  </h1>
  <small
    style={{
      display: "block",
      marginBottom: "45px",
    }}
  >
    (sort of like a rant journal? don't think too much about it)
  </small>

  {
    thoughts.map((thought) => (
      <p>
        <strong>
          {new Date(thought.timestamp).toLocaleString("de-DE").slice(0, -3)}
        </strong>
        -
        {thought.html ? (
          <span set:html={thought.html} />
        ) : (
          <span>{thought.text}</span>
        )}
      </p>
    ))
  }

  <span id="scroll_down"><small>Scroll down ↓</small></span>
  <span id="sentinel"></span>
</Block>

<style lang="scss">
  #thoughts {
    max-height: 400px;
    overflow-y: scroll;
    position: relative;
    padding-bottom: 45px;

    @media (max-width: 700px) {
      padding-top: 80px;
    }

    @media (max-width: 1038px) {
      h1,
      small {
        text-align: center;
      }
    }

    #scroll_down {
      position: sticky;
      bottom: 0;
      right: 0;
      display: block;
      width: fit-content;
      margin-left: auto;
      opacity: 0.5;

      @media (max-width: 700px) {
        position: absolute;
        top: 50px;
        bottom: auto;
        right: 15px;
      }
    }

    p {
      margin-bottom: 16px;
      max-width: 70%;

      a {
        display: inline-block;
      }

      @media (max-width: 700px) {
        max-width: 100%;
      }
    }
  }
</style>

<script>
  import { getRecord, setRecord } from "../scripts/achievementsRecord";

  const thoughtsEl = document.querySelector("#thoughts")!;
  const sentinel = document.querySelector("#sentinel")!;

  if (getRecord("captains_journal") !== 100) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setRecord("captains_journal", 100);
          observer.disconnect();
        }
      },
      { root: thoughtsEl, threshold: 1.0 },
    );

    thoughtsEl.addEventListener(
      "scroll",
      () => {
        observer.observe(sentinel);
      },
      { once: true },
    );
  }
</script>
