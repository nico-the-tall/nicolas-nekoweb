---
const { title, id } = Astro.props;
---

<div class="achievement_block" data-id={id}>
  <strong><small>{title}</small></strong>
  <div class="achievement_completion">
    <small class="achievement_status">In Progress</small>
    <small class="achievement_percent">0%</small>
  </div>
</div>

<style lang="scss">
  .achievement_block {
    color: black;

    .achievement_completion {
      display: flex;
      justify-content: space-between;
    }
  }
</style>

<script>
  import { initializeRecord, getRecord } from "../scripts/achievementsRecord";
  import { ACHIEVEMENT_UNLOCKED } from "../constants/achievements";
  import { showToast } from "../scripts/toast";

  initializeRecord();

  function updateBlock(block: HTMLElement, value: number) {
    block.querySelector(".achievement_percent")!.textContent = `${value}%`;
    if (value === 100) {
      block.querySelector(".achievement_status")!.textContent = "Completed";
    }
  }

  document
    .querySelectorAll<HTMLElement>(".achievement_block")
    .forEach((block) => {
      updateBlock(block, getRecord(block.dataset.id!));
    });

  window.addEventListener(ACHIEVEMENT_UNLOCKED, (e: Event) => {
    const { id, value } = (e as CustomEvent<{ id: string; value: number }>)
      .detail;
    const block = document.querySelector<HTMLElement>(
      `.achievement_block[data-id="${id}"]`,
    );
    if (!block) return;

    updateBlock(block, value);
    if (value === 100) {
      showToast(id);
    }
  });
</script>
