---
const { class: className, ...rest } = Astro.props;
---

<div class={`block_wrapper ${className ? className : ""}`} {...rest}>
  <slot />
</div>

<style>
  .block_wrapper {
    background: rgb(12, 2, 65, 0.75);
    border: 15px ridge rgb(82, 77, 151);
    padding: 18px;
    width: 100%;
  }
</style>
