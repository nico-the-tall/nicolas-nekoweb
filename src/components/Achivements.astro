---
import trophyImage from "../assets/trophy.gif";
import { Image } from "astro:assets";
import AchievementBlock from "./AchievementBlock.astro";
import { achievements } from "../constants/achievements";
---

<div id="achievements_wrapper">
  <button id="achievements_panel_control">
    <div>
      <Image src={trophyImage} alt="Trophy image" />
    </div>
    <span>Click here for achievements</span>
  </button>

  <div id="achievements_panel_clip">
    <div id="achievements_panel">
      <small>
        Are you bored? This website contains 6 secret achievements you can
        unlock.
      </small>

      {
        achievements.map(({ title, id }) => (
          <AchievementBlock title={title} id={id} />
        ))
      }

      <div id="achievements_troubleshooter">
        <small>Do you see weird values for the percentages?</small>
        <button id="achievements_troubleshooter_control">
          Click here to restart progress
        </button>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  #achievements_wrapper {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    margin-left: 16px;
    max-width: 455px;

    #achievements_panel_control {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      background: #ffffb1;
      border-radius: 10px;
      padding: 8px;
      cursor: pointer;
      z-index: 2;
      position: relative;
    }

    #achievements_panel_clip {
      overflow: hidden;
      margin-top: -50px;
      padding-top: 50px;

      @media (max-width: 768px) {
        margin-top: -40px;
        padding-top: 40px;
      }
    }

    #achievements_panel {
      background: white;
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 50px;
      transform: translateY(-100%);
      transition: transform 0.3s ease;
      z-index: 1;
      position: relative;

      #achievements_troubleshooter {
        display: flex;
        flex-direction: column;
        margin-top: 32px;

        small,
        button {
          display: block;
          font-size: 0.5rem;
          margin: 0;
          text-align: center;
        }

        button {
          background: none;
          border: none;
          color: blue;
          cursor: pointer;
        }
      }

      small {
        display: block;
        color: black;
        margin-bottom: 16px;
      }

      &.open {
        transform: translateY(16px);
      }
    }
  }
</style>

<script>
  import { initializeRecord } from "../scripts/achievementsRecord";

  const button = document.querySelector("#achievements_panel_control");
  const panel = document.querySelector("#achievements_panel");

  button?.addEventListener("click", () => {
    panel?.classList.toggle("open");
  });

  document
    .querySelector("#achievements_troubleshooter_control")!
    .addEventListener("click", () => {
      initializeRecord(true);
      window.location.reload();
    });
</script>
