---
import Starry from "../components/Starry.astro";
import Title from "../components/Title.astro";
import DevControls from "../components/DevControls.astro";
import Toast from "../components/Toast.astro";

const { title, showFollowButton, hideTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=vt323:400,700"
      rel="stylesheet"
    />
    <title>Nico's space</title>
  </head>
  <body>
    {import.meta.env.DEV && <DevControls />}
    {!hideTitle && <Title title={title} showFollowButton={showFollowButton} />}

    <Toast />
    <div id="wrapper">
      <Starry />
      <slot />
    </div>
  </body>
</html>

<style is:global lang="scss">
  h1,
  h2,
  h3,
  h4,
  h5 {
    font-size: 1.4rem;
  }

  a {
    color: rgb(255, 255, 93);
  }

  p {
    font-size: 1rem;
    margin: 0;
  }

  small {
    font-size: 0.8rem;
  }

  strong {
    color: rgb(255, 28, 28);
  }

  ul {
    list-style: none;

    li {
      margin-left: -1rem;
    }

    li::before {
      content: "* ";
    }
  }
</style>

<style lang="scss">
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: white;
  }

  html,
  body,
  :global(form),
  :global(button),
  :global(td) {
    font-family: "VT323", serif !important;
    font-size: 36px;

    @media (max-width: 768px) {
      font-size: 24px;
    }
  }

  @keyframes title {
    0% {
      filter: hue-rotate(0deg);
    }
    100% {
      filter: hue-rotate(360deg);
    }
  }

  #wrapper {
    max-width: 1200px;
    margin: auto;
    background: rgba(22, 18, 82, 0.45);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    border: 10px double rgb(82, 77, 151);
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 5px,
        rgba(99, 102, 241, 0.15) 5px,
        rgba(99, 102, 241, 0.15) 6px,
        transparent 6px,
        transparent 15px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 5px,
        rgba(99, 102, 241, 0.15) 5px,
        rgba(99, 102, 241, 0.15) 6px,
        transparent 6px,
        transparent 15px
      ),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 10px,
        rgba(139, 92, 246, 0.12) 10px,
        rgba(139, 92, 246, 0.12) 11px,
        transparent 11px,
        transparent 30px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 10px,
        rgba(139, 92, 246, 0.12) 10px,
        rgba(139, 92, 246, 0.12) 11px,
        transparent 11px,
        transparent 30px
      );
  }
</style>

<script>
  import { getRecord, setRecord } from "../scripts/achievementsRecord";

  /* eslint-disable @typescript-eslint/no-explicit-any */
  if (!(window as any).__timeDilationStarted) {
    (window as any).__timeDilationStarted = true;

    const interval = setInterval(() => {
      const percentage = getRecord("time_dilation");

      if (percentage === 100) {
        clearInterval(interval);
        return;
      }

      setRecord("time_dilation", Math.min(percentage + 5, 100));
    }, 15000);
  }
</script>
