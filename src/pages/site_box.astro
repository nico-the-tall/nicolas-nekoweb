---
import Starry from "../components/Starry.astro";
import Profile from "../assets/profile.gif";
import { Image } from "astro:assets";
import Title from "../components/Title.astro";

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}
---

<!doctype html>
<html lang="en">
  <head>
    <link
      href="https://fonts.bunny.net/css?family=vt323:400,700"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="wrapper">
      <Starry />

      <div id="core">
        <Image class="shake" src={Profile} alt="" />

        <div id="title_wrapper">
          <Title title="Nico's Space" />
        </div>
      </div>
    </div>
  </body>
</html>

<style lang="scss">
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: white;
    font-family: "VT323", serif !important;
    font-size: 36px;
  }

  #core {
    width: 280px;
    height: 195px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;

    #title_wrapper {
      display: flex;
      flex-direction: column;

      :global(div) {
        margin: 0 !important;
      }
    }

    img {
      border-radius: 50%;
    }

    :global(h1) {
      font-size: 1.4rem;
      line-height: 0.8;
    }
  }

  small {
    font-size: 0.8rem;
    margin-bottom: 8px;
    color: rgb(255, 255, 93);
  }

  @keyframes title {
    0% {
      filter: hue-rotate(0deg);
    }
    100% {
      filter: hue-rotate(360deg);
    }
  }

  #wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  @keyframes shake {
    0%,
    100% {
      transform: translate(-3px, 3px);
    }
    25% {
      transform: translate(-3px, -3px);
    }
    75% {
      transform: translate(3px, 3px);
    }
  }

  .shake {
    animation: shake 0.1s ease-in-out infinite;
  }
</style>
