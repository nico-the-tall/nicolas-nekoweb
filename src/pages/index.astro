---
import Base from "@/layouts/Base.astro";
import { Index } from "@/views/Index/Index";
import { getRamblings } from "@/utils/getRamblings";

const ramblings = (await getRamblings()).slice(0, 4);
---

<Base description="Nico's personal corner on the web.">
  <Index ramblings={ramblings} client:load />
</Base>
