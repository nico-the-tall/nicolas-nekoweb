---
import Layout from "../layouts/Layout.astro";
import Block from "../components/Block.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/profile.gif";
import nekowebButton from "../assets/88x31/nekoweb.webp";
import responsiveButton from "../assets/88x31/responsive.png";
import rainbowButton from "../assets/88x31/rainbow.png";
import bisexualButton from "../assets/88x31/bisexual.png";
import humanMadeButton from "../assets/88x31/human-made.gif";
import uBlockOriginButton from "../assets/88x31/ublock-origin.png";
import euroRingButton from "../assets/88x31/euroring.png";
import ByNcSaButton from "../assets/88x31/by-nc-sa.png";
import Wavy from "../components/Wavy.astro";
import NoAI from "../components/webrings/NoAI.astro";
import Euro from "../components/webrings/Euro.astro";
import Webmastery from "../components/webrings/Webmastery.astro";
import Nyan from "../components/webrings/Nyan.astro";
import Online from "../components/webrings/Online.astro";
import Hotline from "../components/webrings/Hotline.astro";
import Retronaut from "../components/webrings/Retronaut.astro";
import Bisexual from "../components/webrings/Bisexual.astro";
import emulateNowButton from "../assets/88x31/emulate.gif";
import r2rButton from "../assets/88x31/r2r.png";
import linuxButton from "../assets/88x31/linux.gif";
import Footer from "../components/Footer.astro";
import Thoughts from "../components/Thoughts.astro";
import firefoxButton from "../assets/88x31/firefox.gif";
import Achievements from "../components/Achivements.astro";
---

<Layout title="Nico's Space" showFollowButton>
  <Achievements />

  <Block id="info_wrapper">
    <div id="pfp_image_wrapper">
      <h2>Hiho! My name is <strong id="name">Nico/Nick/Klaus</strong></h2>

      <div id="pfp_image_block">
        <Wavy />
        <Image src={profileImage} alt="Profile picture" />
      </div>
    </div>

    <div id="about_me">
      <div>
        <strong>About me</strong>
        <ul>
          <li>Software developer</li>
          <li>I live in Germany</li>
          <li>I'm in my late 20s</li>
        </ul>
      </div>

      <div>
        <strong>Things I like</strong>
        <ul>
          <li>Pixel art & liminal/dreamcore stuff</li>
          <li>JRPGs, Megaman and Friendslop games</li>
          <li>Alt, Indie, EMD & Metal music</li>
          <li>Anime & police dramas</li>
        </ul>
      </div>
    </div>
  </Block>

  <Thoughts />

  <Block id="music_block">
    <span>
      Something will go here in the future (I'm still working on this)
    </span>
  </Block>

  <div id="bottom_section">
    <Block id="buttons">
      <h1>You like <strong>buttons?</strong></h1>

      <div id="button_groups">
        <div id="button_group_1">
          <div class="button_groups_stacked">
            <img
              id="nicos_space"
              class="nicos_space_button"
              src="/88x31.png"
              alt="Nico's Space 88x31 button"
              style={{
                width: "88px",
                height: "31px",
              }}
            />
            <img
              id="nicos_space_gif"
              class="nicos_space_button"
              src="/88x31.gif"
              alt="Nico's Space 88x31 gif"
              style={{
                width: "88px",
                height: "31px",
              }}
            />
          </div>

          <div id="button_group_2">
            <small>&lt;-- Click to copy the button code!</small>
          </div>
        </div>

        <div id="button_group_3">
          <a
            class="link_88x31"
            href="https://nekoweb.org/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image src={nekowebButton} alt="Nekoweb 88x31 button" />
          </a>
          <Image src={responsiveButton} alt="Responsive website 88x31 button" />
          <Image src={rainbowButton} alt="LGBT pride 88x31 button" />
          <Image src={bisexualButton} alt="Bisexual pride 88x31 button" />
          <a
            class="link_88x31"
            href="https://ashk.au/2024/02/18/human-made-web-button/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image src={humanMadeButton} alt="Human-made 88x31 button" />
          </a>
          <Image src={uBlockOriginButton} alt="uBlock Origin 88x31 button" />
          <a
            class="link_88x31"
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              height={31}
              width={88}
              src={ByNcSaButton}
              alt="Creative Commons BY-NC-SA 88x31 button"
            />
          </a>
          <Image src={emulateNowButton} alt="Emulate now 88x31 button" />
          <Image src={r2rButton} alt="Right to Repair 88x31 button" />
          <Image src={linuxButton} alt="Made on Linux 88x31 button" />
          <Image src={firefoxButton} alt="Tested on Firefox 88x31 button" />
          <Image src={euroRingButton} alt="Euroring 88x31 button " />
          <a
            href="https://www.sirkorgo.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src="https://www.sirkorgo.com/src/img/bumper.gif"
              alt="sirkorgo 88x31 button"
            />
          </a>
          <a href="https://ghostk.id/">
            <img
              src="https://ghostk.id/i/88x31.gif"
              width="88"
              height="31"
              alt="https://ghostk.id button"
            />
          </a>
          <a href="https://v0idspace.nekoweb.org/">
            <img src="https://v0idspace.nekoweb.org/stamps/v0idbutton.gif" />
          </a>
        </div>
      </div>
    </Block>

    <Block id="socials">
      <h1>Some of my <strong>socials</strong></h1>

      <p>You can find me on:</p>
      <ul>
        <li>
          Discord: <a
            href="https://discord.com/users/907441653760032839"
            target="_blank"
            rel="noopener noreferrer"
          >
            nico.the.tall
          </a>
        </li>
        <li>
          Email: <a
            href="mailto:nico.the.tall@proton.me"
            target="_blank"
            rel="noopener noreferrer"
          >
            nico.the.tall@proton.me
          </a>
        </li>
        <li>
          AniList: <a
            href="https://anilist.co/user/NicoTheTall"
            target="_blank"
            rel="noopener noreferrer"
          >
            NicoTheTall
          </a>
        </li>
        <li>
          Codeberg: <a
            href="https://codeberg.org/nico-the-tall"
            target="_blank"
            rel="noopener noreferrer"
          >
            nico-the-tall
          </a>
        </li>
      </ul>
    </Block>

    <Block id="webrings">
      <h1>The <strong>Webrings</strong> corner</h1>

      <div id="webrings_list">
        <NoAI />
        <Euro />
        <Bisexual />
        <Online />
        <Webmastery />
        <Hotline />
        <Retronaut />
        <Nyan />
      </div>
    </Block>
  </div>
</Layout>

<Footer />

<style is:global>
  div {
    box-sizing: border-box;
  }

  p,
  span {
    word-wrap: break-word;
  }
</style>

<style lang="scss">
  @media (max-width: 1038px) {
    h1 {
      text-align: center;
    }
  }

  #info_wrapper {
    #pfp_image_wrapper {
      h2 {
        strong {
          display: block;
        }
      }

      display: flex;
      align-items: center;
      justify-content: space-around;

      @media (max-width: 1270px) {
        flex-direction: column-reverse;

        h2 {
          text-align: center;
        }
      }

      #pfp_image_block {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;

        @media (max-width: 730px) {
          flex-direction: column;
        }

        img {
          width: 100%;
          height: auto;
          max-width: 250px;
          image-rendering: pixelated;
          filter: brightness(0.75);
          border-radius: 35%;
        }
      }
    }

    #about_me {
      display: flex;
      justify-content: space-around;
      margin-top: 32px;

      @media (max-width: 1080px) {
        flex-direction: column;
        align-items: center;
        gap: 24px;

        div {
          width: 100%;
          display: flex;
          align-items: center;
          flex-direction: column;

          li {
            text-align: center;

            &:before {
              display: none;
            }
          }
        }
      }

      strong {
        text-align: center;
        display: block;
      }

      ul {
        margin: 0;
      }
    }
  }

  #bottom_section {
    display: grid;
    grid-template-areas: "buttons buttons webrings" "socials socials webrings";
    grid-template-columns: 2fr 2fr min-content;
    gap: 16px;

    @media (max-width: 1200px) {
      grid-template-areas: "buttons buttons buttons" "socials socials webrings" "socials socials webrings";
    }

    @media (max-width: 1038px) {
      grid-template-areas: "buttons" "webrings" "socials";
      grid-template-columns: 1fr;
    }

    #buttons {
      grid-area: buttons;

      .link_88x31 {
        line-height: 0;
      }

      #button_groups {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        justify-content: space-around;
        gap: 8px;

        img {
          width: 88px;
          height: 31px;
        }

        @media (max-width: 1200px) {
          max-width: 800px;
          margin: auto;
        }

        @media (max-width: 680px) {
          grid-template-rows: auto 1fr;
          grid-template-columns: 1fr;
          gap: 32px;
        }

        .button_groups_stacked {
          display: flex;
          flex-direction: column;
          gap: 8px;
        }

        @keyframes float-up-fade {
          0% {
            opacity: 1;
            transform: translateY(0);
          }
          100% {
            opacity: 0;
            transform: translateY(-48px);
          }
        }

        :global(.copied-toast) {
          position: absolute;
          pointer-events: none;
          font-weight: bold;
          font-size: 0.5rem;
          color: white;
          animation: float-up-fade 1s ease-out forwards;
        }

        #button_group_1 {
          position: relative;
          display: flex;
          align-items: center;
          gap: 16px;

          @media (max-width: 680px) {
            justify-content: center;
          }

          .nicos_space_button {
            cursor: pointer;
          }
        }

        #button_group_2 {
          max-width: 200px;
          line-height: 25px;

          small {
            font-size: 0.8rem;
          }
        }

        #button_group_3 {
          display: flex;
          flex-wrap: wrap;
          gap: 4px;

          @media (max-width: 1038px) {
            justify-content: flex-end;
          }

          @media (max-width: 680px) {
            justify-content: center;
          }
        }
      }
    }

    #socials {
      grid-area: socials;
    }

    #webrings {
      grid-area: webrings;

      @media (min-width: 1039px) {
        width: 330px;
      }

      #webrings_list {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }
    }
  }
</style>

<script>
  import { getRecord, setRecord } from "../scripts/achievementsRecord";

  document.querySelector("#name")?.addEventListener("click", () => {
    const current = getRecord("nico_nico_nii");

    if (current !== 100) {
      setRecord("nico_nico_nii", Math.min(current + 40, 100));
    }
  });

  document
    .querySelector("#button_group_3")!
    .addEventListener("mouseover", (e) => {
      const img = (e.target as HTMLElement).closest("img");

      if (!img || getRecord("space_cadet") === 100) return;

      setRecord("space_cadet", Math.min(getRecord("space_cadet") + 1, 100));
    });

  async function handleNicosSpaceButtonClick(type: "png" | "gif") {
    const toCopy = `<a href="https://nicolas.nekoweb.org/"><img src="https://nicolas.nekoweb.org/88x31.${type}" width="88" height="31" alt="Nico's Space 88x31 button"/></a>`;
    await navigator.clipboard.writeText(toCopy);

    const group = document.querySelector(
      "#button_group_1 .button_groups_stacked",
    ) as HTMLElement;

    const toast = document.createElement("span");
    toast.className = "copied-toast";
    toast.textContent = "COPIED";
    group.appendChild(toast);
    toast.addEventListener("animationend", () => toast.remove());
  }

  document.querySelector("#nicos_space")?.addEventListener("click", () => {
    handleNicosSpaceButtonClick("png");
  });

  document.querySelector("#nicos_space_gif")?.addEventListener("click", () => {
    handleNicosSpaceButtonClick("gif");
  });
</script>
