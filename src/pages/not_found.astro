---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Achievements from "../components/Achivements.astro";
---

<Layout title="Achievement Unlocked!">
  <Achievements />
  <h1>You have unlocked the <strong>Lost in Space</strong> achievement</h1>
  <p>
    Don't know how you got here, but you have found an <strong>error</strong> of the
    <strong>404</strong> kind.
  </p>
  <p>You now have 2 options dear traveler:</p>
  <ul>
    <li>
      <a href="/index.html">Click here</a> to return to safety immediately.
    </li>
    <li>
      <a href="https://en.wikipedia.org/wiki/Special:Random">Click here</a> for a
      <strong>random</strong> Wikipedia article.
    </li>
  </ul>
</Layout>

<Footer />

<script>
  import { getRecord, setRecord } from "../scripts/achievementsRecord";

  if (getRecord("lost_in_space") !== 100) {
    setRecord("lost_in_space", 100);
  }
</script>
