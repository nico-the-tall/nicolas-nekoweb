---
import { getCollection, render } from "astro:content";
import { Rambling } from "@/views/Rambling/Rambling";
import { getRamblings } from "@/utils/getRamblings";
import Base from "@/layouts/Base.astro";

export async function getStaticPaths() {
  const ramblings = await getCollection("ramblings");

  return ramblings.map((rambling) => ({
    params: { slug: rambling.id },
    props: { rambling },
  }));
}

const { rambling } = Astro.props;
const { Content } = await render(rambling);
const ramblings = await getRamblings();
---

<Base title={rambling.data.title} description={rambling.data.description}>
  <article>
    <Rambling
      title={rambling.data.title}
      date={rambling.data.date}
      ramblings={ramblings}
    >
      <Content components={{ h1: "h2", h2: "h3" }} />
    </Rambling>
  </article>
</Base>
